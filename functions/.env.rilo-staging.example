# Staging Functions — copiá a functions/.env.rilo-staging (gitignore).
# Región: southamerica-east1 (misma que producción).
# Producción usa functions/.env.rilo-7eff4 — no mezclar.

RILO_ENV=staging
FIREBASE_PROJECT_ID=rilo-staging
APP_URL=
# Completar tras Hosting staging

GEMINI_API_KEY=
# OPENAI_API_KEY → Secret Manager (functions:api)

WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_STAGING_ALLOWLIST=
WHATSAPP_QA_PHONE=

TRIAL_OTP_DEV_MODE=true
TRIAL_EMAIL_DEV_MODE=true
TRIAL_EMAIL_SEND_IN_DEV=false
RESEND_API_KEY=
TRIAL_EMAIL_FROM=

MERCADOPAGO_USE_SANDBOX=true
MERCADOPAGO_ACCESS_TOKEN_UY=
MERCADOPAGO_ACCESS_TOKEN_AR=

JWT_SECRET=
PLATFORM_ADMIN_USER=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_EMAIL=

# RILOBOT_CONVERSATION_ENGINE=v4
# RILOBOT_AI_PROVIDER=openai
