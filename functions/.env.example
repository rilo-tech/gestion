# Producción:  copiá a functions/.env.rilo-7eff4 (gitignore).
# Staging:     copiá a functions/.env.rilo-staging (gitignore) — ver .env.staging.example.
# No mezclar tokens WhatsApp / MP / AI de producción en staging.

GEMINI_API_KEY=
GEMINI_WHATSAPP_MODEL=gemini-3.5-flash-lite
# Opcional. Si está vacío, el interpreter reintenta el mismo primario.
# GEMINI_WHATSAPP_FALLBACK_MODEL=
GEMINI_INTERPRETER_TIMEOUT_MS=20000
GEMINI_INTERPRETER_RETRY_TIMEOUT_MS=15000
# Core conversacional v3 (QueryPlan). Vacío = off. Lista de businessId, p.ej. rilo
# RILOBOT_V3_TENANTS=rilo
# RILOBOT_CONVERSATION_ENGINE=llm_first

# Core conversacional v4 (tool calling + OpenAI Responses). Vacío = off salvo engine global v4.
# V4 (defaults en functions/src/index.ts; override aquí solo si hace falta)
# RILOBOT_CONVERSATION_ENGINE=v4
# RILOBOT_V4_TENANTS=rilo
# RILOBOT_AI_PROVIDER=openai
# OPENAI_RILOBOT_MODEL=gpt-5.6-terra
# OPENAI_RILOBOT_FALLBACK_MODEL=gpt-5.6-luna
# OPENAI_RILOBOT_REASONING_EFFORT=low
# OPENAI_API_KEY → Firebase Secret Manager (functions:api), no en .env
WHATSAPP_WEBHOOK_VERIFY_TOKEN=rilo-prod-verify
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# Mercado Pago (UY / AR)
MERCADOPAGO_ACCESS_TOKEN_UY=
MERCADOPAGO_ACCESS_TOKEN_AR=
# MERCADOPAGO_PUBLIC_KEY_UY=
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_USE_SANDBOX=true
APP_URL=https://rilo-7eff4.web.app
