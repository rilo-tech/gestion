# =============================================================================
# RILO — variables de STAGING (plantilla)
# =============================================================================
# Copiá a `.env.staging` y `functions/.env.rilo-staging` (gitignored).
# NUNCA pegues secretos reales en docs ni en git.
#
# Producción = rilo-7eff4 → NO usar para QA.
# Staging project id = rilo-staging (crear en Console si aún no existe).
# Región Functions/Hosting rewrite: southamerica-east1 (igual que prod).
# =============================================================================

# ── Identidad de entorno ──
RILO_ENV=staging
VITE_RILO_ENV=staging
USE_FIRESTORE_EMULATOR=false
FIREBASE_PROJECT_ID=rilo-staging
VITE_FIREBASE_PROJECT_ID=rilo-staging
VITE_FIREBASE_AUTH_DOMAIN=rilo-staging.firebaseapp.com
VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_STORAGE_BUCKET=rilo-staging.firebasestorage.app
VITE_USE_FIREBASE_AUTH_EMULATOR=false

# URLs (rellenar DESPUÉS del primer deploy staging — no inventar)
APP_URL=
VITE_API_BASE_URL=
# STAGING_APP_URL=

# Auth / plataforma
JWT_SECRET=
PLATFORM_ADMIN_USER=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_EMAIL=
SKIP_DEFAULT_BUSINESS=true

# Trial / email — OTP en pantalla OK en staging; NUNCA en production
TRIAL_EMAIL_SEND_IN_DEV=false
TRIAL_OTP_DEV_MODE=true
TRIAL_EMAIL_DEV_MODE=true
TRIAL_EMAIL_FROM=
RESEND_API_KEY=
TRIAL_DEFAULT_PLAN_ID=plan_intermedio

# WhatsApp Meta — app/número de PRUEBA
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v21.0
VITE_RILOBOT_WHATSAPP=
VITE_RILOBOT_WHATSAPP_DISPLAY=
VITE_SUPPORT_WHATSAPP_URL=
# Destinatarios QA permitidos (E164, coma-separados). Sin lista = ningún envío.
WHATSAPP_STAGING_ALLOWLIST=
# Teléfono owner seed (debe estar en allowlist)
WHATSAPP_QA_PHONE=

# AI (claves staging; Secret Manager OPENAI_API_KEY en Functions)
GEMINI_API_KEY=
# RILOBOT_CONVERSATION_ENGINE=v4
# RILOBOT_AI_PROVIDER=openai

# Mercado Pago — SANDBOX obligatorio en staging
MERCADOPAGO_USE_SANDBOX=true
MERCADOPAGO_ACCESS_TOKEN_UY=
MERCADOPAGO_ACCESS_TOKEN_AR=

# Analytics externo (Meta/GA4) OFF por default
VITE_ANALYTICS_EXTERNAL=false
# ANALYTICS_EXTERNAL=false

# Admin SDK staging (path local)
# GOOGLE_APPLICATION_CREDENTIALS=credentials/rilo-staging-firebase-adminsdk.json
